{
  "version": 2,
  "functions": {
    "api/check-poa.js": {
      "maxDuration": 60
    },
    "api/analyze-poa.js": {
      "maxDuration": 60
    },
    "api/check-estate.js": {
      "maxDuration": 60
    },
    "api/analyze-estate.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/main.html"
    },
    {
      "source": "/index.html",
      "destination": "/public/main.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
